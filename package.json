{
  "name": "agent-talk",
  "version": "0.1.4",
  "description": "Interactive terminal voice companion for coding agents. Codex supported; Claude coming soon.",
  "type": "module",
  "bin": {
    "agent-talk": "bin/agent-talk.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "files": [
    "bin/agent-talk.mjs",
    "bin/check-package.mjs",
    "AGENT-TALK.md",
    "terminal/audio.swift",
    "relay/transcript-store.mjs",
    "terminal/audio.mjs",
    "terminal/cli.mjs",
    "terminal/handoff-file.mjs",
    "terminal/picker.mjs",
    "terminal/session.mjs",
    "terminal/ui.mjs",
    "terminal/preferences.mjs",
    "terminal/orb.mjs",
    "relay/diagnostics.mjs",
    "relay/handoff.mjs",
    "relay/queue-message.mjs",
    "relay/replies.mjs",
    "relay/reply-watcher.mjs",
    "relay/server.mjs",
    "relay/session-context.mjs",
    "relay/session-cost.mjs",
    "terminal/screen.mjs",
    "bin/install.mjs"
  ],
  "scripts": {
    "test": "node --test bin/*.test.mjs terminal/*.test.mjs relay/*.test.mjs",
    "prepack": "node bin/check-package.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "ws": "^8.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sambernhardt/agent-talk.git"
  },
  "homepage": "https://github.com/sambernhardt/agent-talk"
}
